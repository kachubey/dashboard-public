{
  "name": "users-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose --env-file .env.local -f docker-compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "import": "tsx --env-file=.env.local scripts/import.mts",
    "keys:generate": "node -e \"console.log('k'+new Date().toISOString().slice(0,7).replace('-','')+':'+require('crypto').randomBytes(32).toString('base64'))\"",
    "keys:rotate": "tsx --env-file=.env.local scripts/rotate-keys.mts",
    "build:cli": "node scripts/build-cli.mjs",
    "e2e": "./e2e/reset.sh && mkdir -p .e2e-shots && node e2e/shell.mjs .e2e-shots && ./e2e/reset.sh && node e2e/vpn.mjs .e2e-shots && ./e2e/reset.sh && node e2e/admin.mjs .e2e-shots e2e/upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "1.7.7",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tar-stream": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
