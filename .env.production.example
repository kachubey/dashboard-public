# Production settings — copy to `.env` next to docker-compose.prod.yml on the
# server (chmod 600). Never commit the real file. See docs/DEPLOY.md.

# --- Host & TLS --------------------------------------------------------------
# Public host name of the portal (DNS A/AAAA record → this server).
PORTAL_HOST=portal.example.com
# Leave empty for Let's Encrypt. "tls internal" = Caddy's own CA (test
# servers without public DNS; browsers warn).
CADDY_TLS=

# --- App ---------------------------------------------------------------------
BETTER_AUTH_URL=https://portal.example.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=
SESSION_MAX_AGE_HOURS=8
SUPPORT_URL=https://help.example.com
APP_TIME_ZONE=UTC

# --- Database ----------------------------------------------------------------
# Owner of the database — used only by the one-shot "migrate" service.
# openssl rand -hex 24   (hex: safe inside the connection URL)
POSTGRES_PASSWORD=
# Restricted role the app runs as (no schema changes, audit log append-only).
# openssl rand -hex 24
APP_DB_PASSWORD=

# --- Encryption at rest ------------------------------------------------------
# Generate:  echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# then put the whole line in CONFIG_ENC_KEYS and the part before ":" in
# CONFIG_ENC_ACTIVE_KEY_ID. BACK UP these keys separately from the database
# backups — without them the configs in a backup can't be decrypted.
CONFIG_ENC_KEYS=
CONFIG_ENC_ACTIVE_KEY_ID=

# --- Microsoft Entra ID (docs/ENTRA_SETUP.md) --------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Secret VALUE. Expiry date: ____-__-__ (reminder set: yes/no)
ENTRA_CLIENT_SECRET=
FEATURE_EMPLOYEE_ID=false

# Exactly one UPN domain is required in production (shortUPN owner namespace).
ALLOWED_UPN_DOMAINS=example.com

# AUTH_MOCK must NOT appear in this file — the app refuses to start if it does.
