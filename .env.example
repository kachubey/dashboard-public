# Employee Portal — environment variables.
# Copy to `.env.local` for development. In production, pass these via the
# container environment (docker compose `env_file`), never bake them into images.

# --- Core -------------------------------------------------------------------

# Public base URL of the portal. Must match the Entra redirect URI origin.
#   dev:  http://localhost:3000
#   prod: https://portal.example.com
BETTER_AUTH_URL=http://localhost:3000

# Secret used to sign session cookies and encrypt OAuth state/tokens.
# Generate with: openssl rand -base64 48
# Rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Public development-only default; set DATABASE_URL to the same password.
# Existing database volumes retain their original password.
DEV_POSTGRES_PASSWORD=local-demo-only

# PostgreSQL connection string.
#   dev (local PostgreSQL): postgres://portal:local-demo-only@localhost:5432/portal
#   prod (compose network):          postgres://portal:<password>@db:5432/portal
DATABASE_URL=postgres://portal:local-demo-only@localhost:5432/portal

# --- Encryption at rest ------------------------------------------------------

# AES-256 keys that encrypt config contents in the database: comma-separated
# "<id>:<base64 of 32 random bytes>". Generate one with: npm run keys:generate
# BACK THESE UP separately from database backups — without the key the
# encrypted configs are unrecoverable. Rotation: see scripts/rotate-keys.mts.
CONFIG_ENC_KEYS=
# Which key in CONFIG_ENC_KEYS encrypts new data.
CONFIG_ENC_ACTIVE_KEY_ID=

# --- Microsoft Entra ID (see docs/ENTRA_SETUP.md) ----------------------------

# Directory (tenant) ID — single-tenant app, never "common".
ENTRA_TENANT_ID=
# Application (client) ID of the app registration.
ENTRA_CLIENT_ID=
# Client secret VALUE (not the secret ID). Note its expiry date in your calendar.
ENTRA_CLIENT_SECRET=

# Read `employeeId` from Microsoft Graph (/me?$select=employeeId) at sign-in.
# Needs only the delegated User.Read permission. true | false
FEATURE_EMPLOYEE_ID=false

# Comma-separated UPN domains allowed to sign in (recommended: your one
# domain). Owner keys use the part of the UPN before "@", so two domains
# could map two people to the same key. Empty = any domain in the tenant.
ALLOWED_UPN_DOMAINS=

# With FEATURE_EMPLOYEE_ID=true, owner keys in file names that match this
# pattern (case-insensitive) are treated as employee codes, e.g. E1042.
EMPLOYEE_CODE_REGEX=^[a-z]\d{3,8}$

# --- Session -----------------------------------------------------------------

# Absolute session lifetime in hours (no sliding refresh). Roles are re-read
# from Entra at each sign-in, so this is the upper bound for a role removal
# to take effect.
SESSION_MAX_AGE_HOURS=8

# --- UI ----------------------------------------------------------------------

# Support link shown when a user has no configs.
SUPPORT_URL=https://help.example.com

# IANA time zone used to display dates (last updated, audit log).
APP_TIME_ZONE=UTC

# --- Development only --------------------------------------------------------

# Mock sign-in with seeded fake users, no Entra needed.
# Works only when NODE_ENV=development AND AUTH_MOCK=true.
# The app refuses to start in production if this variable is set at all.
AUTH_MOCK=true
